# ------------------------------------------------------------------
# SmartHire AI — Environment Variables Template
# Copy this file to `.env` and fill in real values for your machine.
# NEVER commit the real `.env` file — it is already in .gitignore.
# ------------------------------------------------------------------

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# ------------------------------------------------------------------
# MySQL Community Edition
# ------------------------------------------------------------------
# Preferred names (Phase 2+) — use these:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=smarthire_ai
# Legacy alias (supported for backward compatibility):
# MYSQL_DB=smarthire_ai

# Alternatively, you can provide a full connection URL directly
# (overrides the individual MYSQL_* variables above):
# DATABASE_URL=mysql+pymysql://root:your-mysql-password@localhost:3306/smarthire_ai

# ------------------------------------------------------------------
# File uploads
# ------------------------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
AI_ENGINE_VERSION=1.0.0
APP_TIMEZONE=UTC

# ------------------------------------------------------------------
# Flask-Login
# ------------------------------------------------------------------
# FLASK_LOGIN_LOGIN_VIEW=auth.login
# FLASK_LOGIN_SESSION_PROTECTION=strong

# ------------------------------------------------------------------
# Development-only admin seed (never commit real values)
# ------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-development-password
# DEMO_RECRUITER_PASSWORD=change-this-demo-password

# ------------------------------------------------------------------
# Commands cheat-sheet (run inside `venv`):
#   $ flask --app run.py db init          # First time only -> creates migrations/
#   $ flask --app run.py db migrate -m "Initial database models"
#   $ flask --app run.py db upgrade       # Apply to MySQL
#   $ python seed_data.py                 # Seed roles + 25 skills
# ------------------------------------------------------------------
